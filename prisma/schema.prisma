generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  industry   String?
  size       String?
  revenue    Float?
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  people     Person[]
  teams      Team[]
  projects   Project[]
  connectors Connector[]

  @@index([tenantId])
}

model Person {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  role           String?
  department     String?
  avatar         String?
  status         String   @default("active")
  riskScore      Float    @default(0)
  influenceScore Float    @default(50)
  orgId          String?
  organization   Organization? @relation(fields: [orgId], references: [id])
  teamId         String?
  team           Team?    @relation(fields: [teamId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  authoredDocs   Document[]
  decisions      Decision[]
  assignedTasks  Task[]
  events         Event[]

  @@index([status])
  @@index([teamId])
  @@index([orgId])
}

model Team {
  id           String   @id @default(cuid())
  name         String
  description  String?
  color        String   @default("#10b981")
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects     Project[]
  members      Person[]
}

model Project {
  id           String   @id @default(cuid())
  name         String
  description  String?
  status       String   @default("active")
  health       Float    @default(85)
  progress     Float    @default(0)
  riskScore    Float    @default(15)
  budget       Float?
  budgetUsed   Float    @default(0)
  startDate    DateTime?
  endDate      DateTime?
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  teamId       String?
  team         Team?    @relation(fields: [teamId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks        Task[]
  decisions    Decision[]
  events       Event[]

  @@index([status])
  @@index([teamId])
  @@index([orgId])
}

model Decision {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("proposed")
  impact      String   @default("medium")
  confidence  Float    @default(0.5)
  reasoning   String?
  madeById    String?
  madeBy      Person?  @relation(fields: [madeById], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events      Event[]

  @@index([status])
  @@index([projectId])
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("todo")
  priority    String   @default("medium")
  assigneeId  String?
  assignee    Person?  @relation(fields: [assigneeId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([assigneeId])
  @@index([projectId])
}

model Document {
  id          String   @id @default(cuid())
  title       String
  content     String?
  type        String   @default("general")
  authorId    String?
  author      Person?  @relation(fields: [authorId], references: [id])
  embedding   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
}

model Event {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?
  severity    String   @default("info")
  source      String?
  metadata    String?
  personId    String?
  person      Person?  @relation(fields: [personId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
  decisionId  String?
  decision    Decision? @relation(fields: [decisionId], references: [id])
  createdAt   DateTime @default(now())

  @@index([severity])
  @@index([type])
  @@index([createdAt])
  @@index([personId])
  @@index([projectId])
}

model GraphEntity {
  id         String   @id @default(cuid())
  type       String
  name       String
  properties String?
  embedding  String?
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sourceRelations GraphRelation[] @relation("SourceEntity")
  targetRelations GraphRelation[] @relation("TargetEntity")

  @@index([type])
  @@index([tenantId])
}

model GraphRelation {
  id         String   @id @default(cuid())
  type       String
  sourceId   String
  source     GraphEntity @relation("SourceEntity", fields: [sourceId], references: [id])
  targetId   String
  target     GraphEntity @relation("TargetEntity", fields: [targetId], references: [id])
  properties String?
  weight     Float    @default(1)
  createdAt  DateTime @default(now())

  @@index([sourceId])
  @@index([targetId])
}

model Agent {
  id           String   @id @default(cuid())
  name         String
  type         String
  description  String?
  status       String   @default("idle")
  avatar       String?
  capabilities String?
  lastAction   String?
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actions   AgentAction[]
  workflows AgentWorkflow[]
  memories  AgentMemory[]

  @@index([status])
  @@index([tenantId])
}

model AgentAction {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
  type        String
  title       String
  description String?
  result      String?
  status      String   @default("pending")
  confidence  Float?
  evidence    String?
  createdAt   DateTime @default(now())

  @@index([agentId])
}

model Memory {
  id          String   @id @default(cuid())
  type        String
  title       String
  content     String
  source      String?
  importance  Float    @default(0.5)
  tags        String?
  embedding   String?
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([importance])
  @@index([tenantId])
}

model Prediction {
  id          String   @id @default(cuid())
  type        String
  title       String
  description String?
  probability Float
  impact      String   @default("medium")
  timeframe   String?
  status      String   @default("active")
  evidence    String?
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([tenantId])
}

model Connector {
  id          String   @id @default(cuid())
  name        String
  type        String
  category    String
  status      String   @default("connected")
  lastSync    DateTime?
  recordCount Int?
  orgId       String?
  organization Organization? @relation(fields: [orgId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  syncs    ConnectorSync[]
  webhooks ConnectorWebhook[]

  @@index([status])
  @@index([orgId])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  actor        String?
  actorId      String?
  resource     String?
  resourceType String?
  details      String?
  severity     String   @default("info")
  ipAddress    String?
  userAgent    String?
  requestId    String?
  duration     Float?
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())

  @@index([severity])
  @@index([createdAt])
  @@index([tenantId])
  @@index([actorId])
  @@index([action])
}

model ChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  agentType String?
  createdAt DateTime @default(now())

  @@index([agentType])
  @@index([createdAt])
}

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  passwordHash         String
  role                 String    @default("user")
  avatar               String?
  department           String?
  lastLoginAt          DateTime?
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  mfaSecret            String?
  mfaEnabled           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenantMemberships TenantMember[]
  apiKeys           ApiKey[]

  @@index([email])
  @@index([lockedUntil])
}

// ═══════════════════════════════════════════════════════════════════
// Multi-Tenancy
// ═══════════════════════════════════════════════════════════════════

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?
  plan        String   @default("professional")
  status      String   @default("active")
  maxUsers    Int      @default(50)
  maxAgents   Int      @default(10)
  maxStorage  BigInt   @default(10737418240)
  settings    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       TenantMember[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  organizations Organization[]
  agents        Agent[]
  memories      Memory[]
  predictions   Prediction[]
  graphEntities GraphEntity[]

  @@index([slug])
  @@index([status])
  @@index([domain])
}

model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("viewer")
  status    String   @default("active")
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([role])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String
  keyPrefix   String
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  permissions String?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  status      String    @default("active")
  createdAt   DateTime  @default(now())

  @@index([keyHash])
  @@index([tenantId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════
// Domain Events (Event Sourcing)
// ═══════════════════════════════════════════════════════════════════

model DomainEvent {
  id            String   @id @default(cuid())
  eventType     String
  aggregateId   String
  aggregateType String
  version       Int      @default(1)
  payload       String
  metadata      String?
  actorId       String?
  actorType     String?
  tenantId      String?
  createdAt     DateTime @default(now())

  @@index([aggregateId])
  @@index([aggregateType])
  @@index([eventType])
  @@index([createdAt])
  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════════════
// Agent Framework
// ═══════════════════════════════════════════════════════════════════

model AgentWorkflow {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id])
  type        String
  status      String   @default("pending")
  definition  String
  context     String?
  result      String?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentId])
  @@index([status])
  @@index([createdAt])
}

model AgentMemory {
  id             String    @id @default(cuid())
  agentId        String
  agent          Agent     @relation(fields: [agentId], references: [id])
  type           String
  category       String?
  content        String
  embedding      String?
  importance     Float     @default(0.5)
  accessCount    Int       @default(0)
  lastAccessedAt DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([agentId])
  @@index([type])
  @@index([importance])
}

// ═══════════════════════════════════════════════════════════════════
// Connector Framework
// ═══════════════════════════════════════════════════════════════════

model ConnectorSync {
  id            String    @id @default(cuid())
  connectorId   String
  connector     Connector @relation(fields: [connectorId], references: [id])
  status        String    @default("pending")
  recordsSynced Int       @default(0)
  recordsCreated Int      @default(0)
  recordsUpdated Int      @default(0)
  recordsFailed Int       @default(0)
  error         String?
  duration      Int       @default(0)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([connectorId])
  @@index([status])
  @@index([createdAt])
}

model ConnectorWebhook {
  id            String    @id @default(cuid())
  connectorId   String
  connector     Connector @relation(fields: [connectorId], references: [id])
  eventType     String
  payload       String
  signature     String?
  status        String    @default("pending")
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([connectorId])
  @@index([status])
  @@index([eventType])
}

// ═══════════════════════════════════════════════════════════════════
// Feedback & Learning
// ═══════════════════════════════════════════════════════════════════

model Feedback {
  id          String   @id @default(cuid())
  targetType  String
  targetId    String
  userId      String?
  rating      Int
  comment     String?
  tags        String?
  createdAt   DateTime @default(now())

  @@index([targetType])
  @@index([targetId])
  @@index([userId])
  @@index([rating])
}

model QualityScore {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  metric      String
  score       Float
  sampleSize  Int      @default(1)
  period      String
  periodStart DateTime
  createdAt   DateTime @default(now())

  @@unique([entityType, entityId, metric, period, periodStart])
  @@index([entityType])
  @@index([entityId])
  @@index([metric])
}

// ═══════════════════════════════════════════════════════════════════
// Compliance & Data Governance
// ═══════════════════════════════════════════════════════════════════

model LegalHold {
  id          String   @id @default(cuid())
  reason      String
  entityType  String
  entityIds   String   // JSON array of entity IDs under hold
  initiatedBy String
  status      String   @default("active") // active | released
  releasedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([entityType])
  @@index([initiatedBy])
  @@index([createdAt])
}

model DataLineage {
  id              String   @id @default(cuid())
  dataId          String
  dataType        String
  source          String
  transformation  String?
  destination     String
  actor           String
  tenantId        String?
  createdAt       DateTime @default(now())

  @@index([dataId])
  @@index([dataType])
  @@index([tenantId])
  @@index([createdAt])
}
