DATABASE_URL=file:./db/custom.db
NEXTAUTH_SECRET=nexus-one-dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════
# OLLAMA MODEL CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════
# Only ONE OLLAMA_MODEL should be active (uncommented) at a time.
# To switch: comment out the current one, uncomment your choice, then restart.
# ═══════════════════════════════════════════════════════════════════════

# ── General Purpose (Recommended) ─────────────────────────────────────
OLLAMA_MODEL=llama3.1:8b              # Best all-rounder, fast, low RAM (~6GB)

# ── Better Reasoning ──────────────────────────────────────────────────
#OLLAMA_MODEL=qwen3:8b                # Strong reasoning, good for analysis (~6GB)

# ── Code & Technical ─────────────────────────────────────────────────
#OLLAMA_MODEL=qwen2.5-coder:14b       # Best for code & technical tasks (~10GB)

# ── Highest Quality (Needs More RAM) ─────────────────────────────────
#OLLAMA_MODEL=mistral-small:24b        # Best quality responses (~16GB RAM)

# ═══════════════════════════════════════════════════════════════════════
# Z-AI SDK CONFIGURATION (auto-creates .z-ai-config if missing)
# ═══════════════════════════════════════════════════════════════════════
ZAI_BASE_URL=http://localhost:11434/v1
ZAI_API_KEY=ollama
ZAI_CHAT_ID=nexus-one-boardroom
ZAI_USER_ID=nexus-user
