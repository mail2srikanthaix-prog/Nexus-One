DATABASE_URL=file:./db/custom.db
NEXTAUTH_SECRET=nexus-one-dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Ollama configuration for AI Boardroom
# The .z-ai-config file is auto-created from these env vars if missing
OLLAMA_MODEL=llama3.1:8b
ZAI_BASE_URL=http://localhost:11434/v1
ZAI_API_KEY=ollama
ZAI_CHAT_ID=nexus-one-boardroom
ZAI_USER_ID=nexus-user
