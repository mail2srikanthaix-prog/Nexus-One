{
  "annotations": { "list": [] },
  "description": "Nexus-One Security Monitoring — Auth events, rate limits, audit severity, compliance status",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Failed Logins (1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(nexus_auth_events_total{event=\"login.failed\"}[1h]))",
          "legendFormat": "Failed Logins",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Locked Accounts",
      "type": "stat",
      "targets": [
        {
          "expr": "nexus_accounts_locked_total",
          "legendFormat": "Locked",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Rate Limited Requests (1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(nexus_rate_limited_total[1h]))",
          "legendFormat": "Rate Limited",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Critical Audit Events (1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(nexus_audit_events_total{severity=\"critical\"}[1h]))",
          "legendFormat": "Critical",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "title": "Authentication Events",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(nexus_auth_events_total{event=\"login.success\"}[5m]))",
          "legendFormat": "Login Success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(nexus_auth_events_total{event=\"login.failed\"}[5m]))",
          "legendFormat": "Login Failed",
          "refId": "B"
        },
        {
          "expr": "sum(rate(nexus_auth_events_total{event=\"account.locked\"}[5m]))",
          "legendFormat": "Account Locked",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 15, "lineWidth": 2 } }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "title": "Audit Events by Severity",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(nexus_audit_events_total[5m])) by (severity)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 20, "lineWidth": 2 } }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 18 },
      "id": 7,
      "title": "RBAC Permission Denials",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(nexus_rbac_denials_total[5m])) by (role, resource)",
          "legendFormat": "{{role}} → {{resource}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 18 },
      "id": 8,
      "title": "Compliance Check Status",
      "type": "gauge",
      "targets": [
        {
          "expr": "nexus_compliance_score",
          "legendFormat": "Score",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["nexus-one", "security", "compliance"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Nexus-One — Security Monitoring",
  "uid": "nexus-one-security",
  "version": 1
}
