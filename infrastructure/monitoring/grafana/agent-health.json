{
  "annotations": { "list": [] },
  "description": "Nexus-One Agent Health — Agent status, action rates, workflow completion, memory usage",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Active Agents",
      "type": "stat",
      "targets": [
        {
          "expr": "nexus_agent_active_total",
          "legendFormat": "Active",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Failed Actions (1h)",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(nexus_agent_actions_total{status=\"failed\"}[1h]))",
          "legendFormat": "Failed Actions",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Workflow Success Rate",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(nexus_agent_workflows_total{status=\"completed\"}[5m])) / sum(rate(nexus_agent_workflows_total[5m])) * 100",
          "legendFormat": "Success Rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "Avg Action Duration",
      "type": "stat",
      "targets": [
        {
          "expr": "avg(nexus_agent_action_duration_seconds)",
          "legendFormat": "Avg Duration",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "title": "Agent Actions by Type",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(nexus_agent_actions_total[5m])) by (agent_type)",
          "legendFormat": "{{agent_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 20, "lineWidth": 2 } }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "title": "Agent Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(nexus_agent_memory_entries) by (agent_type)",
          "legendFormat": "{{agent_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 18 },
      "id": 7,
      "title": "Workflow Duration Distribution",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(nexus_agent_workflow_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(nexus_agent_workflow_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 18 },
      "id": 8,
      "title": "LLM Token Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(nexus_llm_tokens_total{direction=\"input\"}[5m]))",
          "legendFormat": "Input Tokens",
          "refId": "A"
        },
        {
          "expr": "sum(rate(nexus_llm_tokens_total{direction=\"output\"}[5m]))",
          "legendFormat": "Output Tokens",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 15, "lineWidth": 2 } }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["nexus-one", "agents", "ai"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Nexus-One — Agent Health",
  "uid": "nexus-one-agent-health",
  "version": 1
}
